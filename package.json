{
  "name": "reflect",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node .neander/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "check": "tsc --noEmit",
    "test": "tsx tests/runtime-guards.ts && tsx tests/email-template.ts && tsx tests/security-regressions.ts && tsx tests/workflows.ts && tsx tests/backup.ts && tsx tests/feature-workflows.ts",
    "db:migrate": "node .neander/migrate.mjs",
    "db:seed": "tsx scripts/seed-template.ts",
    "test:template": "tsx scripts/verify-template.ts",
    "test:policy": "python3 scripts/check_repository.py",
    "verify": "pnpm run check && pnpm run test && pnpm run test:policy && pnpm run build",
    "test:production": "tsx scripts/verify-template.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource/inter": "5.3.0",
    "@next/env": "16.4.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.23.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.0",
    "radix-ui": "1.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.11",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.2",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  }
}
